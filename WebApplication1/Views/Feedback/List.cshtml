@model List<WebApplication1.Models.Feedback>
@{
    ViewData["Title"] = "Feedback List";
}

<h2>All Feedback</h2>
<table class="table table-bordered">
    <thead>
        <tr><th>Enrollment No</th><th>Name</th><th>Subject</th><th>Rating</th><th>Comments</th></tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td>@f.Enrollmentnum</td>
                <td>@f.StudentName</td>
                <td>@f.Subject</td>
                <td>@f.Rating</td>
                <td>@f.Comments</td>
            </tr>
        }
    </tbody>
</table>
@Html.ActionLink("Add New", "Create", "Feedback", null, new { @class = "btn btn-primary" })